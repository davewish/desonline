generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

///////////////////////////////////////
// USER
///////////////////////////////////////
model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  name          String
  password      String
  role          String    @default("USER")
  isActive      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  courses       Course[]
  enrollments   Enrollment[]
  userQuizzes   UserQuiz[]
  userExams     UserExam[]

  // ✅ NEW: video learning system
  lessonProgress LessonProgress[]
  progressEvents ProgressEvent[]

  @@map("users")
}

///////////////////////////////////////
// COURSE
///////////////////////////////////////
model Course {
  id            Int       @id @default(autoincrement())
  title         String
  description   String
  thumbnail     String?
  creatorId     Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  creator       User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  lessons       Lesson[]
  enrollments   Enrollment[]
  exams         Exam[]

  // ✅ NEW
  lessonProgress LessonProgress[]
  progressEvents ProgressEvent[]

  @@map("courses")
}

///////////////////////////////////////
// LESSON
///////////////////////////////////////
model Lesson {
  id            Int       @id @default(autoincrement())
  title         String
  courseId      Int
  position      Int       @default(0)
  videoUrl      String?
  pdfUrl        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizzes       Quiz[]

  // ✅ NEW
  lessonProgress LessonProgress[]
  progressEvents ProgressEvent[]

  @@map("lessons")
}

///////////////////////////////////////
// ENROLLMENT
///////////////////////////////////////
model Enrollment {
  id            Int       @id @default(autoincrement())

  userId        Int
  courseId      Int

  progress      Int       @default(0)

  paymentStatus String    @default("PENDING")
  paidAt        DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

///////////////////////////////////////
// QUIZ
///////////////////////////////////////
model Quiz {
  id            Int       @id @default(autoincrement())
  title         String
  description   String?
  lessonId      Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions     Question[]
  userQuizzes   UserQuiz[]

  @@index([lessonId])
  @@map("quizzes")
}

///////////////////////////////////////
// EXAM
///////////////////////////////////////
model Exam {
  id            Int       @id @default(autoincrement())
  title         String
  description   String?
  courseId      Int
  passingScore  Int       @default(70)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions     Question[]
  userExams     UserExam[]

  @@index([courseId])
  @@map("exams")
}

///////////////////////////////////////
// QUESTION
///////////////////////////////////////
model Question {
  id            Int       @id @default(autoincrement())
  text          String
  options       String[]
  correctAnswer Int
  quizId        Int?
  examId        Int?
  position      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  quiz          Quiz?     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  exam          Exam?     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([examId])
  @@map("questions")
}

///////////////////////////////////////
// USER QUIZ
///////////////////////////////////////
model UserQuiz {
  id            Int       @id @default(autoincrement())
  userId        Int
  quizId        Int
  score         Int
  answers       Json
  completed     Boolean   @default(true)
  attempts      Int       @default(1)
  startedAt     DateTime  @default(now())
  completedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz          Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
  @@index([userId])
  @@index([quizId])
  @@map("user_quizzes")
}

///////////////////////////////////////
// USER EXAM
///////////////////////////////////////
model UserExam {
  id              Int       @id @default(autoincrement())
  userId          Int
  examId          Int
  score           Int
  answers         Json
  passed          Boolean   @default(false)
  attempts        Int       @default(1)
  certificatePath String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam            Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@index([userId])
  @@index([examId])
  @@map("user_exams")
}

///////////////////////////////////////
// 🆕 VIDEO PROGRESS (CORE LMS FEATURE)
///////////////////////////////////////
model LessonProgress {
  id            Int      @id @default(autoincrement())
  userId        Int
  courseId      Int
  lessonId      Int

  currentTime   Float    @default(0)
  duration      Float    @default(0)

  completed     Boolean  @default(false)
  lastWatchedAt DateTime @default(now())

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([courseId])
  @@index([lessonId])
  @@map("lesson_progress")
}

///////////////////////////////////////
// 🆕 ANALYTICS EVENT SYSTEM
///////////////////////////////////////
model ProgressEvent {
  id          Int      @id @default(autoincrement())
  userId      Int
  courseId    Int
  lessonId    Int

  eventType   String   // VIDEO_PROGRESS | PAUSE | COMPLETE
  value       Float?
  meta        Json?

  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([lessonId])
  @@index([eventType])
  @@map("progress_events")
}